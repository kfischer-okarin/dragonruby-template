#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_DIR="$ROOT/mygame/tmp/game"
SCREENSHOT_DIR="$STATE_DIR/screenshots"
PID_FILE="$STATE_DIR/instance.pid"
LOG_FILE="$STATE_DIR/instance.log"
ERROR_FILE="$ROOT/mygame/errors/last.txt"
PORT="$(sed -n 's/^webserver\.port=//p' "$ROOT/mygame/metadata/cvars.txt" 2>/dev/null)"
PORT="${PORT:-9001}"
EVAL_URL="http://localhost:$PORT/dragon/eval/"
ATTACH=false

main() {
  if [ "${1:-}" = "--attach" ]; then
    ATTACH=true
    shift
  fi
  local command="${1:-}"
  shift || true
  case "$command" in
    start) start "$@" ;;
    doctor) doctor ;;
    press) press "$@" ;;
    state) state ;;
    wait-until) wait_until "$@" ;;
    reset) reset "$@" ;;
    screenshot) screenshot "$@" ;;
    pixel) pixel "$@" ;;
    eval) eval_command "$@" ;;
    stop) stop ;;
    *) usage ;;
  esac
}

usage() {
  cat >&2 <<'USAGE'
Usage: scripts/game [--attach] <command>
  --attach                    Use whatever game listens on the port, e.g. one you started
                              yourself, instead of the instance this script started
  start [--headless]         Launch an instance owned by this script and wait until it ticks
  doctor                      Check the instance is ours, alive, answering, and error-free
  press [--player N] <button>...
                              Press controller buttons in order through the engine's input
                              path, e.g. up down left right a b x y l1 r1 start select
  state                       Print the tick and whatever GameCli.state returns
  wait-until <ruby> [secs]    Poll a Ruby expression until it is truthy (default 60s)
  reset [setup]               Restart the game from tick 0, then run GameCli.setup(:setup)
  screenshot <name>           Save mygame/tmp/game/screenshots/<name>.png and print its path
  pixel <name> <x,y>...       Print the RGB of screenshot pixels, in game coordinates (origin bottom left)
  eval <ruby>                 Evaluate Ruby in the instance and print the inspected result
  stop                        Stop the instance this script started
USAGE
  exit 2
}

start() {
  refuse_when_attached start
  local headless=false
  [ "${1:-}" = "--headless" ] && headless=true
  if $headless && grep -q '^shaders=true' "$ROOT/mygame/metadata/game_metadata.txt" 2>/dev/null; then
    echo "--headless cannot start this game: shaders=true needs a GPU renderer, which no headless video" >&2
    echo "driver provides. Run 'scripts/game start' without --headless (it returns focus to your app)." >&2
    exit 2
  fi

  if instance_alive; then
    echo "Instance already running (PID $(cat "$PID_FILE"))."
    return 0
  fi

  local port_owner
  port_owner="$(port_owner)"
  if [ -n "$port_owner" ]; then
    echo "Port $PORT is owned by PID $port_owner, which this script did not start." >&2
    echo "Leaving it alone; stop it yourself if it should go." >&2
    exit 1
  fi

  mkdir -p "$STATE_DIR"
  local frontmost_app
  frontmost_app="$(frontmost_app_name)"
  local video_env=()
  $headless && video_env=(SDL_VIDEODRIVER=dummy)
  cd "$ROOT"
  nohup env SDL_AUDIODRIVER=dummy ${video_env[@]+"${video_env[@]}"} ./dragonruby mygame >"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  for _ in $(seq 1 60); do
    if ! instance_alive; then
      echo "Instance exited during startup. Log tail:" >&2
      tail -20 "$LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    if [ "$(eval_ruby 'Kernel.tick_count > 1' 2>/dev/null)" = "true" ]; then
      $headless || return_focus_to "$frontmost_app"
      echo "Instance ready (PID $(cat "$PID_FILE"), log $LOG_FILE)."
      return 0
    fi
    sleep 0.5
  done
  echo "Instance did not become ready within 30s. Log: $LOG_FILE" >&2
  exit 1
}

doctor() {
  local ok=true
  require_instance
  local pid port_owner
  port_owner="$(port_owner)"
  if $ATTACH; then
    echo "ok   port $PORT owned by PID $port_owner (attached)"
  else
    pid="$(cat "$PID_FILE")"
    if [ "$port_owner" = "$pid" ]; then
      echo "ok   port $PORT owned by our PID $pid"
    else
      echo "FAIL port $PORT owned by PID '${port_owner:-nobody}', expected $pid" >&2
      ok=false
    fi
  fi
  local info
  if info="$(eval_ruby '[$gtk.production? ? :production : :development, Kernel.tick_count]')"; then
    echo "ok   eval answers: $info"
  else
    echo "FAIL eval endpoint does not answer" >&2
    ok=false
  fi
  if $ATTACH; then
    echo "--   errors since start not checked: this script did not start the game"
  elif new_error_since_start; then
    echo "FAIL the game raised an error since start. See $ERROR_FILE" >&2
    ok=false
  else
    echo "ok   no game error since start"
  fi
  $ok
}

press() {
  local player=1
  if [ "${1:-}" = "--player" ]; then
    player="${2:?--player needs a number}"
    shift 2
  fi
  [ $# -gt 0 ] || usage
  require_instance
  local error_stamp_before
  error_stamp_before="$(error_log_stamp)"

  local ruby
  ruby="$(cat <<RUBY
lookup = GTK::Runtime::CBridge::RAW_CONTROLLER_KEY_LOOKUP
names = %i[$*]
unknown = names.reject { |name| lookup.value?(name) }
raise "Unknown button(s) #{unknown.join(' ')}. Use: #{lookup.values.join(' ')}" unless unknown.empty?

t = Kernel.tick_count
names.each_with_index do |name, i|
  code = lookup.key(name)
  \$gtk.on_tick_count(t + 1 + (2 * i)) { \$gtk.controller_key_event $player, code, :key_down }
  \$gtk.on_tick_count(t + 2 + (2 * i)) { \$gtk.controller_key_event $player, code, :key_up }
end
t + 1 + (2 * names.length)
RUBY
)"
  local done_tick
  done_tick="$(eval_ruby "$ruby")"
  if ! [[ "$done_tick" =~ ^[0-9]+$ ]]; then
    echo "$done_tick" >&2
    exit 2
  fi
  local deadline=$((SECONDS + 10))
  until [ "$(eval_ruby "Kernel.tick_count >= $done_tick")" = "true" ]; do
    if [ "$(error_log_stamp)" != "$error_stamp_before" ]; then
      echo "The game raised an error during the presses. See $ERROR_FILE" >&2
      exit 1
    fi
    if [ $SECONDS -ge $deadline ]; then
      echo "The presses did not finish within 10s (tick $(eval_ruby 'Kernel.tick_count'), expected $done_tick)." >&2
      exit 1
    fi
    sleep 0.1
  done
  if [ "$(error_log_stamp)" != "$error_stamp_before" ]; then
    echo "The game raised an error during the presses. See $ERROR_FILE" >&2
    exit 1
  fi
  echo "Pressed $* (done at tick $done_tick)."
}

state() {
  require_instance
  eval_ruby "$(cat <<'RUBY'
result = { tick: Kernel.tick_count }
game_cli = Object.const_defined?(:GameCli) ? Object.const_get(:GameCli) : nil
result.merge!(game_cli.state) if game_cli&.singleton_methods(false)&.include?(:state)
result
RUBY
)"
  echo
}

wait_until() {
  [ $# -ge 1 ] || usage
  local expression="$1"
  local timeout_seconds="${2:-60}"
  require_instance
  local deadline=$((SECONDS + timeout_seconds))
  local result
  while [ $SECONDS -lt $deadline ]; do
    result="$(eval_ruby "($expression) ? true : false")"
    if [ "$result" = "true" ]; then
      echo "Condition met at tick $(eval_ruby 'Kernel.tick_count')."
      return 0
    fi
    sleep 0.1
  done
  echo "Condition not met within ${timeout_seconds}s: $expression" >&2
  echo "Last state: $(state)" >&2
  exit 1
}

reset() {
  [ $# -le 1 ] || usage
  require_instance
  eval_ruby '$gtk.reset_next_tick' >/dev/null
  sleep 0.2
  wait_until 'Kernel.tick_count > 1' 10 >/dev/null
  if [ $# -eq 0 ]; then
    echo "Game reset."
    return 0
  fi
  local outcome
  outcome="$(eval_ruby "$(cat <<RUBY
begin
  game_cli = Object.const_defined?(:GameCli) ? Object.const_get(:GameCli) : nil
  if game_cli&.singleton_methods(false)&.include?(:setup)
    game_cli.setup(:$1)
    :ran
  else
    :no_hook
  end
rescue StandardError => e
  "#{e.class}: #{e.message}"
end
RUBY
)")"
  case "$outcome" in
    ran) echo "Game reset with setup '$1'." ;;
    no_hook)
      echo "Game reset, but GameCli.setup is not defined, so setup '$1' did not run." >&2
      exit 1
      ;;
    *)
      echo "Game reset, but setup '$1' failed: $outcome" >&2
      exit 1
      ;;
  esac
}

# The opaque black chroma key keeps black areas black: the default key turns
# them transparent.
screenshot() {
  [ $# -eq 1 ] || usage
  require_instance
  local relative_path="tmp/game/screenshots/$1.png"
  mkdir -p "$(dirname "$ROOT/mygame/$relative_path")"
  rm -f "$ROOT/mygame/$relative_path"
  eval_ruby "\$outputs.screenshots << { x: 0, y: 0, w: \$args.grid.w, h: \$args.grid.h, path: '$relative_path', r: 0, g: 0, b: 0, a: 255 }" >/dev/null
  for _ in $(seq 1 50); do
    if [ -s "$ROOT/mygame/$relative_path" ]; then
      echo "$ROOT/mygame/$relative_path"
      return 0
    fi
    sleep 0.1
  done
  echo "Screenshot was not written: $ROOT/mygame/$relative_path" >&2
  exit 1
}

pixel() {
  [ $# -ge 2 ] || usage
  local png="$SCREENSHOT_DIR/$1.png"
  shift
  if [ ! -f "$png" ]; then
    echo "No screenshot at $png" >&2
    exit 1
  fi
  python3 -I "$SCRIPT_DIR/png_pixels.py" "$png" "$@"
}

eval_command() {
  [ $# -eq 1 ] || usage
  require_instance
  eval_ruby "$1"
  echo
}

stop() {
  refuse_when_attached stop
  if [ ! -f "$PID_FILE" ]; then
    echo "No instance started by this script."
    return 0
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
  fi
  rm -f "$PID_FILE"
  echo "Stopped PID $pid."
}

require_instance() {
  if $ATTACH; then
    [ -n "$(port_owner)" ] && return 0
    echo "No game listens on port $PORT." >&2
    exit 1
  fi
  if ! instance_alive; then
    echo "No instance started by this script is running. Run: scripts/game start" >&2
    exit 1
  fi
}

refuse_when_attached() {
  $ATTACH || return 0
  echo "$1 only manages the instance this script starts; run it without --attach." >&2
  exit 2
}

instance_alive() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

frontmost_app_name() {
  command -v osascript >/dev/null || return 0
  osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || true
}

return_focus_to() {
  [ -n "$1" ] || return 0
  osascript -e "tell application \"$1\" to activate" >/dev/null 2>&1 ||
    echo "Could not hand focus back to $1. Keystrokes now reach the game window." >&2
}

port_owner() {
  lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true
}

new_error_since_start() {
  [ -f "$ERROR_FILE" ] && [ "$ERROR_FILE" -nt "$PID_FILE" ]
}

# Modification time with fractions of a second (BSD stat, then GNU stat)
error_log_stamp() {
  [ -f "$ERROR_FILE" ] || return 0
  stat -f '%Fm' "$ERROR_FILE" 2>/dev/null || stat -c '%.9Y' "$ERROR_FILE"
}

eval_ruby() {
  local payload
  payload="$(jq -n --arg code "$1" '{code: $code}')"
  local response
  response="$(curl --silent --show-error --max-time 5 --json "$payload" "$EVAL_URL")"
  if [[ "$response" == "* ERROR"* ]]; then
    echo "$response" >&2
    return 1
  fi
  printf '%s' "$response"
}

main "$@"
